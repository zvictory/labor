{
  "name": "labor",
  "version": "0.1.0",
  "private": true,
  "description": "Labor — multi-brand fragrance ecommerce for Uzbekistan (Next.js store, Telegram bot inside)",
  "workspaces": [
    "apps/store"
  ],
  "scripts": {
    "dev": "npm run dev -w apps/store",
    "build": "npm run build -w apps/store",
    "lint": "npm run lint -w apps/store",
    "typecheck": "npm run typecheck -w apps/store",
    "test": "npm test -w apps/store",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\""
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "typescript": "^5.6.2"
  },
  "engines": {
    "node": ">=20.11.0",
    "npm": ">=10.0.0"
  },
  "packageManager": "npm@10.8.0"
}
