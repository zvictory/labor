# =============================================================================
# Labor Parfum — store app (apps/store) environment template.
# Copy to `.env` (or `.env.local`) and fill in real values. NEVER commit `.env`.
# =============================================================================

# --- Database (new Prisma/Postgres store DB) --------------------------------
# Postgres connection string used by Prisma at runtime + migrations.
# Matches infra/docker-compose.yml (db: labor_store, user/pass: labor).
DATABASE_URL="postgresql://labor:labor@localhost:5432/labor_store?schema=public"

# --- ETL source (legacy Spree/Rails Postgres, read-only) --------------------
# One-time migration reads from the old Spree DB. Point at a snapshot/replica.
# Connect READ-ONLY. Leave unset outside ETL runs.
SPREE_DATABASE_URL="postgresql://spree:spree@localhost:5433/labor_spree?schema=public"

# --- Object storage (MinIO in dev, S3-compatible in prod) -------------------
# Product images migrated from ActiveStorage live here.
S3_ENDPOINT="http://localhost:9000"      # MinIO API endpoint (dev)
S3_REGION="us-east-1"                     # any value; required by S3 clients
S3_BUCKET="labor-images"                  # bucket holding product imagery
S3_ACCESS_KEY_ID="minioadmin"            # MinIO root user (dev default)
S3_SECRET_ACCESS_KEY="minioadmin"        # MinIO root password (dev default)
S3_FORCE_PATH_STYLE="true"               # MinIO requires path-style addressing
# Public base URL used to build <img> src for stored objects (next/image host
# must be allow-listed in next.config.mjs remotePatterns).
S3_PUBLIC_URL="http://localhost:9000/labor-images"

# --- Telegram -----------------------------------------------------------------
# Bot token from @BotFather. Source of truth for auth is telegram_id.
TELEGRAM_BOT_TOKEN=""                     # real token enables live bot + webapp auth
TELEGRAM_WEBHOOK_SECRET=""               # shared secret for inbound webhook verification

# --- Payments: Payme (JSON-RPC) ----------------------------------------------
PAYME_MERCHANT_ID=""                      # Payme cabinet merchant id
PAYME_KEY=""                              # Payme webhook auth key (Basic auth password)
PAYME_CHECKOUT_URL="https://checkout.paycom.uz" # hosted checkout base (test: test.paycom.uz)

# --- Payments: Click ----------------------------------------------------------
CLICK_SERVICE_ID=""                       # Click service id
CLICK_MERCHANT_ID=""                      # Click merchant id
CLICK_MERCHANT_USER_ID=""                # Click merchant user id
CLICK_SECRET_KEY=""                       # used for MD5/HMAC signature verification

# --- SMS: Eskiz (OTP / order notifications) ----------------------------------
ESKIZ_EMAIL=""                            # Eskiz account email
ESKIZ_PASSWORD=""                         # Eskiz account password (used to fetch a JWT)
ESKIZ_FROM="4546"                         # approved sender/nickname

# --- Auth (Auth.js / NextAuth) -----------------------------------------------
NEXTAUTH_URL="http://localhost:3002"     # canonical app URL (no trailing slash)
NEXTAUTH_SECRET=""                        # generate: openssl rand -base64 32

# ── Yandex Delivery (Cargo) — used by lib/delivery/yandex.ts (P4) ──
YANDEX_DELIVERY_TOKEN=
YANDEX_WAREHOUSE_ADDRESS=
YANDEX_WAREHOUSE_LAT=
YANDEX_WAREHOUSE_LNG=
YANDEX_WAREHOUSE_CONTACT=
YANDEX_WAREHOUSE_PHONE=
