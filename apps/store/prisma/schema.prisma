// Labor Parfum — Prisma schema for the Next.js 15 + Postgres rebuild.
// Mirrors the existing Spree/Labor data model (verified against apps/backend/db/schema.rb)
// so the ETL in scripts/etl/ maps 1:1. Translatable text uses per-locale JSON
// ({ ru, uz, en }, ru required). Money is INTEGER UZS minor units (so'm).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Per-locale text helper shape (stored as Json): { "ru": "...", "uz": "...", "en": "..." }
/// ru is required; uz/en optional with ru fallback (mirrors Mobility fallbacks uz->ru, en->ru).

// ───────────────────────── Catalog ─────────────────────────

model Brand {
  id          Int               @id @default(autoincrement())
  slug        String            @unique
  name        String
  // i18n text
  description Json? // { ru, uz, en }
  story       Json?
  country     String?
  foundedYear Int?
  website     String?
  niche       Boolean           @default(false)
  active      Boolean           @default(true)
  logoUrl     String? // not present in Spree; null until brand logos exist
  products    FragranceDetail[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([active])
}

model Note {
  id           Int           @id @default(autoincrement())
  slug         String        @unique
  name         Json // { ru, uz, en }
  description  Json?
  family       String?
  iconUrl      String?
  productNotes ProductNote[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([family])
}

model Accord {
  id             Int             @id @default(autoincrement())
  slug           String          @unique
  name           Json // { ru, uz, en }
  colorHex       String?
  productAccords ProductAccord[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

model Perfumer {
  id               Int               @id @default(autoincrement())
  slug             String            @unique
  name             String
  bio              Json? // { ru, uz, en }
  country          String?
  productPerfumers ProductPerfumer[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
}

model Product {
  id            Int               @id @default(autoincrement())
  slug          String            @unique
  name          Json // { ru, uz, en } (ru required)
  description   Json?
  status        String            @default("active") // active | draft | archived
  availableOn   DateTime?
  // money: integer UZS minor units
  price         Int               @default(0)
  // relations
  fragrance     FragranceDetail?
  notes         ProductNote[]
  accords       ProductAccord[]
  perfumers     ProductPerfumer[]
  images        ProductImage[]
  similarsFrom  ProductSimilar[]  @relation("similarFrom")
  similarsTo    ProductSimilar[]  @relation("similarTo")
  cartItems     CartItem[]
  orderItems    OrderItem[]
  votes         Vote[]
  wishlistItems WishlistItem[]
  campaigns     CampaignProduct[]
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([status])
}

model FragranceDetail {
  id               Int      @id @default(autoincrement())
  productId        Int      @unique
  product          Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  brandId          Int?
  brand            Brand?   @relation(fields: [brandId], references: [id])
  gender           String   @default("unisex") // men | women | unisex
  concentration    String?
  releaseYear      Int?
  volumeMl         Int?
  avgRating        Decimal  @default(0) @db.Decimal(3, 2)
  avgLongevity     Decimal  @default(0) @db.Decimal(3, 2)
  avgSillage       Decimal  @default(0) @db.Decimal(3, 2)
  reviewsCount     Int      @default(0)
  votesCount       Int      @default(0)
  discontinued     Boolean  @default(false)
  loveBreakdown    Json     @default("{}")
  seasonsBreakdown Json     @default("{}")
  timeBreakdown    Json     @default("{}")

  @@index([brandId])
  @@index([gender])
  @@index([avgRating])
}

model ProductNote {
  id           Int     @id @default(autoincrement())
  productId    Int
  product      Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  noteId       Int
  note         Note    @relation(fields: [noteId], references: [id])
  pyramidLayer String // top | middle | base
  position     Int     @default(0)

  @@unique([productId, noteId, pyramidLayer])
  @@index([noteId])
}

model ProductAccord {
  id        Int     @id @default(autoincrement())
  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  accordId  Int
  accord    Accord  @relation(fields: [accordId], references: [id])
  weight    Int     @default(50)

  @@unique([productId, accordId])
  @@index([accordId])
  @@index([productId, weight])
}

model ProductPerfumer {
  id         Int      @id @default(autoincrement())
  productId  Int
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  perfumerId Int
  perfumer   Perfumer @relation(fields: [perfumerId], references: [id])

  @@unique([productId, perfumerId])
  @@index([perfumerId])
}

model ProductSimilar {
  id        Int      @id @default(autoincrement())
  productId Int
  product   Product  @relation("similarFrom", fields: [productId], references: [id], onDelete: Cascade)
  similarId Int
  similar   Product  @relation("similarTo", fields: [similarId], references: [id], onDelete: Cascade)
  score     Decimal? @db.Decimal(5, 4)
  source    String   @default("computed")

  @@unique([productId, similarId])
  @@index([similarId])
}

model ProductImage {
  id        Int     @id @default(autoincrement())
  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String // object-storage URL (migrated from ActiveStorage)
  alt       String?
  position  Int     @default(0)

  @@index([productId])
}

// ───────────────────────── Users & engagement ─────────────────────────

model User {
  id              Int            @id @default(autoincrement())
  telegramId      BigInt?        @unique // SOURCE OF TRUTH for Telegram users
  email           String?        @unique // may be synthesized tg_{id}@labor.local
  phone           String?        @unique
  name            String?
  preferredLocale String         @default("ru") // ru | uz | en
  role            String         @default("customer") // customer | staff | admin
  passwordHash    String? // staff only
  carts           Cart[]
  orders          Order[]
  votes           Vote[]
  wishlistItems   WishlistItem[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
}

model Vote {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId Int
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  rating    Int?
  longevity Int?
  sillage   Int?
  loveLevel String?
  seasons   Json     @default("[]")
  timeOfDay Json     @default("[]")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, productId])
  @@index([productId])
}

model WishlistItem {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId Int
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
  @@index([productId])
}

// ───────────────────────── Commerce ─────────────────────────

model Cart {
  id        Int        @id @default(autoincrement())
  userId    Int?
  user      User?      @relation(fields: [userId], references: [id])
  token     String     @unique // guest cart token
  items     CartItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([userId])
}

model CartItem {
  id        Int     @id @default(autoincrement())
  cartId    Int
  cart      Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId Int
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int     @default(1)
  // optional decant/sample flag from the prototype
  isSample  Boolean @default(false)

  @@unique([cartId, productId, isSample])
  @@index([productId])
}

model Order {
  id             Int                   @id @default(autoincrement())
  number         String                @unique
  userId         Int?
  user           User?                 @relation(fields: [userId], references: [id])
  status         String                @default("pending") // pending|confirmed|paid|shipped|delivered|canceled
  paymentStatus  String                @default("unpaid") // unpaid|paid|refunded
  total          Int                   @default(0) // UZS minor units
  // shipping snapshot
  region         String?
  district       String?
  address        String?
  phone          String?
  deliveryMethod String?
  items          OrderItem[]
  payments       Payment[]
  webhookEvents  PaymentWebhookEvent[]
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  @@index([userId])
  @@index([status])
  @@index([paymentStatus])
}

model OrderItem {
  id        Int     @id @default(autoincrement())
  orderId   Int
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId Int
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int     @default(1)
  unitPrice Int // UZS minor units, snapshot
  isSample  Boolean @default(false)

  @@index([orderId])
  @@index([productId])
}

model Payment {
  id            Int      @id @default(autoincrement())
  orderId       Int
  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider      String // payme | click | uzum
  externalTxnId String?
  amount        Int // UZS minor units
  state         String   @default("created") // created|authorized|paid|canceled
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([orderId])
}

/// Idempotency ledger — preserves the Spree labor_payment_webhook_events pattern.
model PaymentWebhookEvent {
  id            Int       @id @default(autoincrement())
  provider      String
  externalTxnId String
  eventType     String
  payload       Json      @default("{}")
  response      Json      @default("{}")
  status        String    @default("received") // received|processed|failed
  errorMessage  String?
  processedAt   DateTime?
  orderId       Int?
  order         Order?    @relation(fields: [orderId], references: [id])
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([provider, externalTxnId, eventType])
  @@index([orderId])
}

// ───────────────────────── Marketing / campaigns ─────────────────────────

model Campaign {
  id        Int               @id @default(autoincrement())
  slug      String            @unique
  title     Json // { ru, uz, en }
  subtitle  Json?
  body      Json?
  ctaLabel  Json?
  heroImage String?
  active    Boolean           @default(true)
  startsAt  DateTime?
  endsAt    DateTime?
  slides    CampaignSlide[]
  products  CampaignProduct[]
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@index([active])
}

model CampaignSlide {
  id         Int      @id @default(autoincrement())
  campaignId Int
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  imageUrl   String?
  linkUrl    String?
  title      Json?
  subtitle   Json?
  ctaLabel   Json?
  position   Int      @default(0)

  @@index([campaignId])
}

model CampaignProduct {
  id         Int      @id @default(autoincrement())
  campaignId Int
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  productId  Int
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  position   Int      @default(0)

  @@unique([campaignId, productId])
  @@index([productId])
}
