// Labor Parfum — Prisma schema for SQLite standalone execution.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ───────────────────────── Catalog ─────────────────────────

model Brand {
  id          Int               @id @default(autoincrement())
  slug        String            @unique
  name        String
  description String?           // JSON string { ru, uz, en }
  story       String?
  country     String?
  foundedYear Int?
  website     String?
  niche       Boolean           @default(false)
  active      Boolean           @default(true)
  logoUrl     String?
  products    FragranceDetail[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([active])
}

model Note {
  id           Int           @id @default(autoincrement())
  slug         String        @unique
  name         String        // JSON string { ru, uz, en }
  description  String?
  family       String?
  iconUrl      String?
  productNotes ProductNote[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model Accord {
  id            Int             @id @default(autoincrement())
  slug          String          @unique
  name          String          // JSON string { ru, uz, en }
  colorHex      String?
  productAccords ProductAccord[]
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
}

model Perfumer {
  id               Int               @id @default(autoincrement())
  slug             String            @unique
  name             String
  bio              String?           // JSON string { ru, uz, en }
  country          String?
  productPerfumers ProductPerfumer[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
}

model Product {
  id               Int               @id @default(autoincrement())
  slug             String            @unique
  name             String            // JSON string { ru, uz, en }
  description      String?
  status           String            @default("active")
  price            Int               // UZS minor units
  fragrance        FragranceDetail?
  notes            ProductNote[]
  accords          ProductAccord[]
  perfumers        ProductPerfumer[]
  similarsFrom     ProductSimilar[]  @relation("similarFrom")
  similarsTo       ProductSimilar[]  @relation("similarTo")
  images           ProductImage[]
  votes            Vote[]
  wishlistItems    WishlistItem[]
  orderItems       OrderItem[]
  cartItems        CartItem[]
  campaignProducts CampaignProduct[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([status])
}

model FragranceDetail {
  id               Int      @id @default(autoincrement())
  productId        Int      @unique
  product          Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  brandId          Int?
  brand            Brand?   @relation(fields: [brandId], references: [id])
  gender           String   @default("unisex")
  concentration    String?
  releaseYear      Int?
  volumeMl         Int?
  avgRating        Float    @default(0)
  avgLongevity     Float    @default(0)
  avgSillage       Float    @default(0)
  votesCount       Int      @default(0)
  reviewsCount     Int      @default(0)
  discontinued     Boolean  @default(false)
  loveBreakdown    String   @default("{}")
  seasonsBreakdown String   @default("{}")
  timeBreakdown    String   @default("{}")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([brandId])
  @@index([gender])
}

model ProductNote {
  id           Int      @id @default(autoincrement())
  productId    Int
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  noteId       Int
  note         Note     @relation(fields: [noteId], references: [id], onDelete: Cascade)
  pyramidLayer String   @default("top")
  position     Int      @default(0)

  @@unique([productId, noteId, pyramidLayer])
  @@index([noteId])
}

model ProductAccord {
  id        Int      @id @default(autoincrement())
  productId Int
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  accordId  Int
  accord    Accord   @relation(fields: [accordId], references: [id], onDelete: Cascade)
  weight    Int      @default(50)

  @@unique([productId, accordId])
  @@index([accordId])
}

model ProductPerfumer {
  id         Int      @id @default(autoincrement())
  productId  Int
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  perfumerId Int
  perfumer   Perfumer @relation(fields: [perfumerId], references: [id], onDelete: Cascade)

  @@unique([productId, perfumerId])
  @@index([perfumerId])
}

model ProductSimilar {
  id        Int      @id @default(autoincrement())
  productId Int
  product   Product  @relation("similarFrom", fields: [productId], references: [id], onDelete: Cascade)
  similarId Int
  similar   Product  @relation("similarTo", fields: [similarId], references: [id], onDelete: Cascade)
  score     Float?
  source    String   @default("curated")

  @@unique([productId, similarId])
  @@index([similarId])
}

model ProductImage {
  id        Int      @id @default(autoincrement())
  productId Int
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  alt       String?
  position  Int      @default(0)

  @@index([productId])
}

// ───────────────────────── Users & engagement ─────────────────────────

model User {
  id              Int            @id @default(autoincrement())
  telegramId      String?        @unique
  email           String?        @unique
  phone           String?        @unique
  name            String?
  preferredLocale String         @default("ru")
  role            String         @default("customer")
  passwordHash    String?
  carts           Cart[]
  orders          Order[]
  votes           Vote[]
  wishlistItems   WishlistItem[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
}

model OtpCode {
  id         Int       @id @default(autoincrement())
  phone      String
  codeHash   String
  expiresAt  DateTime
  attempts   Int       @default(0)
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([phone])
}

model Vote {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId Int
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  rating    Int?
  longevity Int?
  sillage   Int?
  loveLevel String?
  seasons   String   @default("[]")
  timeOfDay String   @default("[]")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, productId])
  @@index([productId])
}

model WishlistItem {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId Int
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
  @@index([productId])
}

// ───────────────────────── Commerce ─────────────────────────

model Cart {
  id        Int        @id @default(autoincrement())
  userId    Int?
  user      User?      @relation(fields: [userId], references: [id])
  token     String     @unique
  items     CartItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([userId])
}

model CartItem {
  id        Int      @id @default(autoincrement())
  cartId    Int
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId Int
  product   Product  @relation(fields: [productId], references: [id])
  quantity  Int      @default(1)
  isSample  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([cartId, productId, isSample])
  @@index([productId])
}

model Order {
  id             Int                   @id @default(autoincrement())
  number         String                @unique
  userId         Int?
  user           User?                 @relation(fields: [userId], references: [id])
  customerName   String
  customerPhone  String
  customerEmail  String?
  address        String
  region         String
  district       String?
  deliveryMethod String
  deliveryFee    Int                   @default(0)
  total          Int
  status         String                @default("pending")
  paymentMethod  String
  paymentStatus  String                @default("unpaid")
  items          OrderItem[]
  payments       Payment[]
  webhooks       PaymentWebhookEvent[]
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  @@index([userId])
  @@index([status])
  @@index([paymentStatus])
}

model OrderItem {
  id        Int     @id @default(autoincrement())
  orderId   Int
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId Int
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int     @default(1)
  unitPrice Int
  isSample  Boolean @default(false)

  @@index([orderId])
  @@index([productId])
}

model Payment {
  id            Int      @id @default(autoincrement())
  orderId       Int
  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider      String
  externalTxnId String?
  amount        Int
  state         String   @default("created")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([orderId])
}

model PaymentWebhookEvent {
  id            Int       @id @default(autoincrement())
  provider      String
  externalTxnId String
  eventType     String
  payload       String    @default("{}")
  response      String    @default("{}")
  status        String    @default("received")
  errorMessage  String?
  processedAt   DateTime?
  orderId       Int?
  order         Order?    @relation(fields: [orderId], references: [id])
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([provider, externalTxnId, eventType])
  @@index([orderId])
}

// ───────────────────────── Marketing / campaigns ─────────────────────────

model Campaign {
  id        Int               @id @default(autoincrement())
  slug      String            @unique
  title     String            // JSON string { ru, uz, en }
  subtitle  String?
  body      String?
  ctaLabel  String?
  heroImage String?
  active    Boolean           @default(true)
  startsAt  DateTime?
  endsAt    DateTime?
  slides    CampaignSlide[]
  products  CampaignProduct[]
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@index([active])
}

model CampaignSlide {
  id         Int      @id @default(autoincrement())
  campaignId Int
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  imageUrl   String?
  linkUrl    String?
  title      String?
  subtitle   String?
  ctaLabel   String?
  position   Int      @default(0)

  @@index([campaignId])
}

model CampaignProduct {
  id         Int      @id @default(autoincrement())
  campaignId Int
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  productId  Int
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  position   Int      @default(0)

  @@unique([campaignId, productId])
  @@index([productId])
}
