# =============================================================================
# Labor — production environment, /srv/labor/.env on the VPS. NEVER commit `.env`.
#
# infra/docker-compose.yml reads this file for Postgres and the store's build
# arguments, and hands all of it to the store container. Locally the store reads
# apps/store/.env instead (see CLAUDE.md).
#
# Besides the lines below, set the store's own variables here: every key in
# apps/store/.env.example (Telegram, payments, SMS, NextAuth, delivery,
# analytics, cron, Google Wallet). DATABASE_URL and NEXTAUTH_URL are set by the
# compose file and need not be repeated.
# =============================================================================

# ====== Postgres ======
POSTGRES_USER=labor
POSTGRES_PASSWORD=REPLACE_ME_POSTGRES_PASSWORD # REQUIRED — compose refuses to start without it
# The database the container creates on first start. On the current server it is
# labor_production, which still holds the old Spree data (read only by scripts/etl).
POSTGRES_DB=labor_production
# The store's own database, next to it.
STORE_DB=labor_store

# ====== Public site ======
NEXT_PUBLIC_APP_URL=https://laborparfum.com
NEXTAUTH_URL=https://laborparfum.com
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=laborparfum_bot
NEXT_PUBLIC_MINIAPP_URL=https://laborparfum.com/tg

# ====== Telegram ======
# The live bot is connected to Billz (labor.billz.io), which owns its webhook.
# Nothing here, the deploy included, may call setWebhook for it.
TELEGRAM_BOT_TOKEN=REPLACE_ME_TELEGRAM_BOT_TOKEN
TELEGRAM_WEBHOOK_SECRET=REPLACE_ME_AT_LEAST_16_CHARACTERS
